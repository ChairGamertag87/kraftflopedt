# Etape 1 : versionner les assets.
# index.html reference css/*.css et js/*.js sans empreinte, mais nginx les sert
# avec un cache de 7 jours "immutable" (repris par Cloudflare). Apres un deploiement,
# les visiteurs gardaient donc l'ancien JS/CSS avec un index.html neuf.
# On ajoute ?v=<hash du contenu> a chaque reference : une nouvelle version = une
# nouvelle URL, le cache long redevient sans danger.
FROM alpine:3.20 AS assets
WORKDIR /src
COPY index.html robots.txt sitemap.xml googlec21778c174c4ca43.html ./
COPY css ./css
COPY js ./js
RUN set -eu; \
    B="$(grep -cE '(href|src)="(css|js)/' index.html)"; \
    V="$(cat css/*.css js/*.js | sha256sum | cut -c1-12)"; \
    sed -i -E "s#(href|src)=\"(css|js)/([^\"?]+)\"#\1=\"\2/\3?v=${V}\"#g" index.html; \
    A="$(grep -c "?v=${V}\"" index.html)"; \
    echo "assets version ${V} : ${A}/${B} references versionnees"; \
    if [ "${B}" -eq 0 ] || [ "${A}" -ne "${B}" ]; then \
      echo "ERREUR : toutes les references css/js d'index.html doivent etre versionnees"; exit 1; \
    fi

# Etape 2 : image finale nginx
FROM nginx:1.27-alpine

COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
# .inc et non .conf : nginx inclut tout conf.d/*.conf au niveau http, ce
# fichier est inclus explicitement par default.conf dans server et locations.
COPY docker/security-headers.inc /etc/nginx/conf.d/security-headers.inc
COPY --from=assets /src /usr/share/nginx/html

EXPOSE 80
